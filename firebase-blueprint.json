{
  "entities": {
    "User": {
      "title": "User",
      "description": "Patient or administrator account record with profile and contact information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "maxLength": 100, "description": "Full legal name" },
        "phone": { "type": "string", "maxLength": 30, "description": "Primary contact telephone number" },
        "role": { "type": "string", "enum": ["patient", "admin"], "description": "Authorization role" },
        "createdAt": { "type": "string", "description": "ISO timestamp when account was registered" }
      },
      "required": ["uid", "email"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Medical outpatient consultation booking document with admin status handling",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique appointment identifier" },
        "userId": { "type": "string", "description": "Owner patient user ID" },
        "referenceNumber": { "type": "string", "description": "Human-readable hospital booking reference WCH-XXXX" },
        "patientName": { "type": "string", "maxLength": 100, "description": "Name of the consulting patient" },
        "patientPhone": { "type": "string", "maxLength": 30, "description": "Contact phone for confirmations" },
        "patientEmail": { "type": "string", "format": "email", "description": "Email address for digital pass delivery" },
        "departmentId": { "type": "string", "description": "ID of clinical department" },
        "departmentName": { "type": "string", "description": "Name of clinical department" },
        "doctorId": { "type": "string", "description": "Assigned doctor ID or 'any'" },
        "doctorName": { "type": "string", "description": "Assigned physician name" },
        "doctorTitle": { "type": "string", "description": "Doctor designation" },
        "date": { "type": "string", "description": "Appointment date YYYY-MM-DD" },
        "timeSlot": { "type": "string", "description": "Scheduled time window" },
        "consultationType": { "type": "string", "enum": ["in_person", "video", "follow_up"], "description": "Modality of consultation" },
        "symptoms": { "type": "string", "maxLength": 500, "description": "Chief complaints or health reason" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled", "completed"], "description": "Appointment status handled by admin" },
        "adminNotes": { "type": "string", "maxLength": 500, "description": "Notes added by hospital administrator" },
        "fee": { "type": "number", "description": "Consultation fee in USD" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["userId", "patientName", "patientPhone", "patientEmail", "departmentId", "date", "timeSlot", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Individual patient profile documents keyed by Auth UID"
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Hospital appointment bookings indexed by user ID and manageable by admins"
    }
  }
}
